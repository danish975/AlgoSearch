# AlgoSearch Environment Configuration

# Application
NODE_ENV=development
PORT=4000

# C++ Search Engine
SEARCH_ENGINE_URL=http://localhost:8080
SEARCH_ENGINE_PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27017/algosearch
MONGODB_DB_NAME=algosearch

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL_SEARCH=300
REDIS_TTL_AUTOCOMPLETE=60

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
